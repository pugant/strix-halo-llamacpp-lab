+// first non-empty reasoning end tag string in the request data
+static std::string first_reasoning_end_tag(const json & data) {
+    if (data.contains("reasoning_budget_end_tags")) {
+        for (const auto & t : data.at("reasoning_budget_end_tags")) {
+            std::string tag = t.get<std::string>();
+            if (!tag.empty()) {
+                return tag;
+            }
+        }
+    }
+    if (data.contains("reasoning_budget_end_tag")) {
+        return data.at("reasoning_budget_end_tag").get<std::string>();
+    }
+    return "";
+}
