+                    const llama_token tok = ctx->end_matcher.tokens[ctx->end_matcher.pos];
+                    for (size_t i = 0; i < cur_p->size; i++) {
+                        if (cur_p->data[i].id == tok) {
+                            cur_p->data[i].logit += boost;
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+        return; // passthrough
+    }
+
     if (ctx->force_pos >= ctx->forced_tokens.size()) {
         return;
     }
