+// patch 0010: pressure steering helpers
+// Count finite (unmasked) candidates; returns the single unmasked token when count == 1.
+static size_t finite_count_of(const std::vector<llama_token_data> & cur, llama_token & finite_token) {
+    size_t finite_count = 0;
+    finite_token = -1;
+    for (const auto & d : cur) {
+        if (std::isfinite(d.logit)) {
+            finite_count++;
+            finite_token = d.id;
+        }
+    }
+    return finite_count;
+}
+
+static void reset_logits(std::vector<llama_token_data> & cur, float base = 0.0f) {
+    for (auto & d : cur) {
+        d.logit = base;
+    }
+}
+
+// Test 7: pressure notice fires at used >= start*budget, masks all but the current
+// notice token, returns to COUNTING and counting resumes normally afterwards.
+static void test_pressure_notice_and_counting() {
+    common_reasoning_pressure pressure;
+    pressure.start  = 0.5;    // notice at used >= 50
+    pressure.grace  = 200;    // squeeze_from = min(50+200, 99) = 99 -> no squeeze interference
+    pressure.boost  = 5.0;
+    pressure.notice_tokens = {5, 6};
+
+    auto * sampler = common_reasoning_budget_init(nullptr, {1}, {2}, {3}, 100, pressure, REASONING_BUDGET_IDLE);
+
+    std::vector<llama_token_data> cur;
+    for (int i = 0; i < 10; i++) {
+        cur.push_back({(llama_token)i, 0.0f, 0.0f});
+    }
+    llama_token_data_array cur_p = { cur.data(), cur.size(), -1, false };
+    llama_token finite_token = -1;
+
+    llama_sampler_accept(sampler, 1); // activate: COUNTING, remaining = 100
+
+    for (int i = 0; i < 49; i++) {
+        llama_sampler_accept(sampler, 9); // used = 49
+    }
+    reset_logits(cur);
+    llama_sampler_apply(sampler, &cur_p);
+    GGML_ASSERT(finite_count_of(cur, finite_token) == cur.size()); // passthrough below threshold
+
+    llama_sampler_accept(sampler, 9); // used = 50 -> FORCING_NOTA
+    GGML_ASSERT(common_reasoning_budget_get_state(sampler) == REASONING_BUDGET_FORCING_NOTA);
+    reset_logits(cur);
+    llama_sampler_apply(sampler, &cur_p);
+    GGML_ASSERT(finite_count_of(cur, finite_token) == 1 && finite_token == 5);
+
+    llama_sampler_accept(sampler, 5); // notice_pos = 1
+    reset_logits(cur);
+    llama_sampler_apply(sampler, &cur_p);
+    GGML_ASSERT(finite_count_of(cur, finite_token) == 1 && finite_token == 6);
+
+    llama_sampler_accept(sampler, 6); // notice complete -> COUNTING
+    GGML_ASSERT(common_reasoning_budget_get_state(sampler) == REASONING_BUDGET_COUNTING);
+    reset_logits(cur);
+    llama_sampler_apply(sampler, &cur_p);
+    GGML_ASSERT(finite_count_of(cur, finite_token) == cur.size()); // passthrough again
+
+    // counting resumes normally: 49 more tokens -> remaining = 1, then exhaustion forces
+    for (int i = 0; i < 49; i++) {
+        llama_sampler_accept(sampler, 9);
+    }
+    llama_sampler_accept(sampler, 9); // remaining = 0 -> FORCING
+    GGML_ASSERT(common_reasoning_budget_get_state(sampler) == REASONING_BUDGET_FORCING);
+    reset_logits(cur);
+    llama_sampler_apply(sampler, &cur_p);
+    GGML_ASSERT(finite_count_of(cur, finite_token) == 1 && finite_token == 3); // forced[0]
+
+    llama_sampler_free(sampler);
+    fprintf(stderr, "  Test 'pressure notice fires at start fraction and counting resumes' passed\n");
+}
+
+// Test 8: notice-then-squeeze. After the notice completes and used >= squeeze_from,
+// the matcher's next end-token logit gets exactly x*x*boost added (budget=100, start=0.5,
+// grace=10 -> note_from=50, squeeze_from=60; at used=78: x=(78-60)/(100-60)=0.45 -> +1.0125).
+static void test_pressure_notice_then_squeeze() {
+    common_reasoning_pressure pressure;
+    pressure.start  = 0.5;
+    pressure.grace  = 10;
+    pressure.boost  = 5.0;
+    pressure.notice_tokens = {5, 6};
+
+    auto * sampler = common_reasoning_budget_init(nullptr, {1}, {2}, {3}, 100, pressure, REASONING_BUDGET_IDLE);
+
+    std::vector<llama_token_data> cur;
+    for (int i = 0; i < 10; i++) {
+        cur.push_back({(llama_token)i, 0.0f, 0.0f});
+    }
+    llama_token_data_array cur_p = { cur.data(), cur.size(), -1, false };
+    llama_token finite_token = -1;
+
+    llama_sampler_accept(sampler, 1); // activate
+    for (int i = 0; i < 50; i++) {
+        llama_sampler_accept(sampler, 9); // used = 50 -> notice fires
+    }
+    GGML_ASSERT(common_reasoning_budget_get_state(sampler) == REASONING_BUDGET_FORCING_NOTA);
+    llama_sampler_accept(sampler, 5);
+    llama_sampler_accept(sampler, 6); // back to COUNTING, remaining = 50, used = 50
+
+    // used = 57 and used = 58: below squeeze_from (60), no boost yet
+    for (int i = 0; i < 8; i++) {
+        llama_sampler_accept(sampler, 9); // used = 58
+    }
+    reset_logits(cur);
+    llama_sampler_apply(sampler, &cur_p);
+    GGML_ASSERT(fabsf(cur[2].logit) < 1e-6f); // end token untouched below squeeze_from
+
+    // 20 more: used = 78, x = 18/40 = 0.45, boost = 0.45^2 * 5 = 1.0125
+    for (int i = 0; i < 20; i++) {
+        llama_sampler_accept(sampler, 9);
+    }
+    reset_logits(cur);
+    llama_sampler_apply(sampler, &cur_p);
+    GGML_ASSERT(fabsf(cur[2].logit - 1.0125f) < 1e-4f); // end token boosted exactly x*x*boost
+    for (int i = 0; i < 10; i++) {
+        if (i != 2) {
+            GGML_ASSERT(fabsf(cur[i].logit) < 1e-6f); // only the end token is boosted
+        }
+    }
+    (void)finite_token;
+
+    llama_sampler_free(sampler);
+    fprintf(stderr, "  Test 'pressure squeeze adds exactly x*x*boost to the end token' passed\n");
+}
+
+// Test 9: clone mid-FORCING_NOTA. Advance into the notice, clone, push the ORIGINAL
+// past the notice with divergent tokens, then assert the CLONE still masks the notice
+// token at its preserved position (guards the clone state-passthrough fix of 0010).
+static void test_pressure_clone_mid_notice() {
+    common_reasoning_pressure pressure;
+    pressure.start  = 0.5;
+    pressure.grace  = 200;
+    pressure.boost  = 5.0;
+    pressure.notice_tokens = {5, 6, 7}; // 3 tokens so the preserved position is non-trivial
+
+    auto * sampler = common_reasoning_budget_init(nullptr, {1}, {2}, {3}, 100, pressure, REASONING_BUDGET_IDLE);
+
+    std::vector<llama_token_data> cur;
+    for (int i = 0; i < 10; i++) {
+        cur.push_back({(llama_token)i, 0.0f, 0.0f});
+    }
+    llama_token_data_array cur_p = { cur.data(), cur.size(), -1, false };
+    llama_token finite_token = -1;
+
+    llama_sampler_accept(sampler, 1); // activate
+    for (int i = 0; i < 50; i++) {
+        llama_sampler_accept(sampler, 9); // used = 50 -> FORCING_NOTA, notice_pos = 0
+    }
+    llama_sampler_accept(sampler, 5);    // notice_pos = 1
+
+    auto * clone = llama_sampler_clone(sampler);
+
+    // diverge the ORIGINAL: skip the rest of the notice, back to COUNTING
+    llama_sampler_accept(sampler, 9);    // notice_pos = 2
+    llama_sampler_accept(sampler, 9);    // notice_pos = 3 >= size -> COUNTING
+    GGML_ASSERT(common_reasoning_budget_get_state(sampler) == REASONING_BUDGET_COUNTING);
+
+    // the CLONE is unaffected: still mid-notice at notice_pos = 1 -> masks all but 6
+    GGML_ASSERT(common_reasoning_budget_get_state(clone) == REASONING_BUDGET_FORCING_NOTA);
+    reset_logits(cur);
+    llama_sampler_apply(clone, &cur_p);
+    GGML_ASSERT(finite_count_of(cur, finite_token) == 1 && finite_token == 6);
+
+    llama_sampler_free(sampler);
+    llama_sampler_free(clone);
+    fprintf(stderr, "  Test 'clone mid-notice preserves notice position' passed\n");
+}
