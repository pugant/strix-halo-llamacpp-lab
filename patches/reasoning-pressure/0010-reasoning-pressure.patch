+// mask every candidate except `token` (shared by FORCING and FORCING_NOTA)
+static void force_only(llama_token_data_array * cur_p, llama_token token) {
+    for (size_t i = 0; i < cur_p->size; i++) {
+        if (cur_p->data[i].id != token) {
+            cur_p->data[i].logit = -INFINITY;
+        }
+    }
+}
