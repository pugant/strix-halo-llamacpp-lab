+// thresholds are a PURE function of (pressure, budget): recomputed everywhere
+// (init, arm, clone passthrough in init_state) — a restored clone can never
+// carry stale or zeroed thresholds (spec §4: soglie carried by clone)
+static void common_reasoning_budget_compute_thresholds(common_reasoning_budget_ctx * ctx) {
+    if (ctx->pressure.enabled() && ctx->budget > 0) {
+        ctx->note_from    = ctx->pressure.start * ctx->budget;
+        ctx->squeeze_from = std::min(ctx->pressure.start * ctx->budget + (double) ctx->pressure.grace,
+                                     (double) ctx->budget - 1.0);
+    } else {
+        ctx->note_from    = 0.0;
+        ctx->squeeze_from = 0.0;
+    }
+}
+
+// reset the per-think-block flags (fresh block or sampler reset)
+static void common_reasoning_budget_arm_pressure(common_reasoning_budget_ctx * ctx) {
+    ctx->note_injected = false;
+    ctx->note_pending  = false;
+    ctx->notice_pos    = 0;
+    common_reasoning_budget_compute_thresholds(ctx);
+}
