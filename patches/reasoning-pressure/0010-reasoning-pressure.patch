+// Soft steering of the reasoning budget (patch 0010, spec 2026-08-17-reasoning-pressure):
+// at `start` fraction of the budget a deterministic notice is forced into the reasoning
+// (token-by-token, same masking as FORCING) and counting resumes; `grace` tokens later a
+// quadratic squeeze begins, boosting only the logit of the next end-token expected by the
+// matcher, up to `boost`. Inert when start == 0 or notice_tokens is empty.
+struct common_reasoning_pressure {
+    double       start  = 0.0;
+    int32_t      grace  = 0;
+    double       boost  = 0.0;
+    std::vector<llama_token> notice_tokens;
+
+    bool enabled() const { return start > 0.0 && !notice_tokens.empty(); }
+};
+
+// default notice text (shared by the server parse and the common fallback)
+inline const char * COMMON_REASONING_PRESSURE_DEFAULT_NOTICE = "[Budget notice: wrap up the reasoning and give the final answer]";
+
 // Creates a reasoning budget sampler that limits token generation inside a
 // reasoning block (e.g. between <think> and </think>).
 //
 // State machine: IDLE -> COUNTING -> WAITING_UTF8 -> FORCING -> DONE
-//   IDLE:         passthrough, watching for start_tokens sequence
-//   COUNTING:     counting down remaining tokens, watching for natural end_tokens
-//   WAITING_UTF8: budget exhausted, allowing tokens to complete a UTF-8 sequence
-//   FORCING:      forces forced_tokens token-by-token (all other logits -> -inf)
-//   DONE:         passthrough forever
+//   IDLE:          passthrough, watching for start_tokens sequence
+//   COUNTING:      counting down remaining tokens, watching for natural end_tokens
+//   WAITING_UTF8:  budget exhausted, allowing tokens to complete a UTF-8 sequence
+//   FORCING:       forces forced_tokens token-by-token (all other logits -> -inf)
+//   FORCING_NOTA:  forces pressure.notice_tokens token-by-token, then back to COUNTING
+//   DONE:          passthrough forever
 //
 // Parameters:
 //   vocab          - vocabulary (used for UTF-8 boundary detection; can be nullptr)
@@ -29,6 +48,7 @@ enum common_reasoning_budget_state {
