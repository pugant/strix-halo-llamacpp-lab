     auto * ctx = (common_reasoning_budget_ctx *) smpl->ctx;
 
-    if (ctx->state != REASONING_BUDGET_FORCING) {
-        // passthrough — don't modify logits
+    if (ctx->state == REASONING_BUDGET_FORCING_NOTA) {
+        if (ctx->notice_pos >= ctx->pressure.notice_tokens.size()) {
+            return;
+        }
+        force_only(cur_p, ctx->pressure.notice_tokens[ctx->notice_pos]);
         return;
     }
 
+    if (ctx->state != REASONING_BUDGET_FORCING) {
+        // patch 0010: squeeze = derived condition while counting (NOT a state):
+        // quadratic boost of ONLY the next end-token expected by the matcher.
+        // NOTE: this apply runs BEFORE grammar and the sampler chain (rbudget
+        // apply order in common_sampler_sample), so the boost sees the full candidate set.
+        if (ctx->state == REASONING_BUDGET_COUNTING && ctx->pressure.enabled() && ctx->note_injected) {
+            const double used = ctx->budget - ctx->remaining;
+            if (used >= ctx->squeeze_from) {
+                double x = (used - ctx->squeeze_from) / ((double) ctx->budget - ctx->squeeze_from);
