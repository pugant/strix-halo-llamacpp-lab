From 3fc3dbb58dff5248e8105a5c0040d465188c0173 Mon Sep 17 00:00:00 2001
From: pugant <pugant@local>
Date: Wed, 19 Aug 2026 14:50:23 +0200
Subject: [PATCH 02/14] spec: set drafter field in positional draft-params
 initializers

73997c973 added common_speculative_draft_params::drafter as the second
field but did not update the positional brace-init lists (the '.x ='
markers are comments, not designated initializers), so the second element
landed on the enum field and both call sites failed to compile.

Initialize it to COMMON_SPECULATIVE_TYPE_NONE (pre-routing behavior:
every implementation eligible to draft) in server-context.cpp and
speculative-simple.cpp.

Co-Authored-By: GLM by z.ai <glm@z.ai>
---
 examples/speculative-simple/speculative-simple.cpp | 4 ++++
 tools/server/server-context.cpp                    | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/examples/speculative-simple/speculative-simple.cpp b/examples/speculative-simple/speculative-simple.cpp
index 461021ea4..d1155cad5 100644
--- a/examples/speculative-simple/speculative-simple.cpp
+++ b/examples/speculative-simple/speculative-simple.cpp
@@ -183,6 +183,10 @@ int main(int argc, char ** argv) {
             // generate a new draft
             common_speculative_get_draft_params(spec, seq_id) = {
                 /* .drafting   = */ true,
+                // note: this list is positional - keep the order in sync with
+                // common_speculative_draft_params. No per-seq drafter selection
+                // here: NONE keeps every implementation eligible to draft.
+                /* .drafter    = */ COMMON_SPECULATIVE_TYPE_NONE,
                 /* .n_max      = */ -1,
                 /* .n_past     = */ n_past,
                 /* .pos_next   = */ n_past, // no M-RoPE media here: position == token count
diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index e41d3d624..97a6387ff 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -2534,6 +2534,10 @@ private:
 
                         common_speculative_get_draft_params(spec.get(), slot.id) = {
                             /* .drafting = */ true,
+                            // note: this list is positional - keep the order in sync with
+                            // common_speculative_draft_params. No per-seq drafter selection
+                            // here: NONE keeps every implementation eligible to draft.
+                            /* .drafter  = */ COMMON_SPECULATIVE_TYPE_NONE,
                             /* .n_max    = */ std::min(n_draft_max, sd.n_max),
                             /* .n_past   = */ slot.prompt.n_tokens(),
                             // M-RoPE-aware position for the draft-mtp boundary and
