From 2bd77f00ed54b2310c4e069374721b0dbc80f217 Mon Sep 17 00:00:00 2001
From: pugant <pugant@localhost>
Date: Fri, 28 Aug 2026 09:40:51 +0200
Subject: [PATCH 1/8] model(qwen4exp-mtp): T2 models.h protected graph access +
 graph_mtp struct

---
 src/models/models.h | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/models/models.h b/src/models/models.h
index 19685bb5c..a03e07705 100644
--- a/src/models/models.h
+++ b/src/models/models.h
@@ -1948,7 +1948,12 @@ struct llama_model_qwen4exp : public llama_model_base {
 
     struct graph : public llm_build_delta_net_base {
         graph(const llama_model & model, const llm_graph_params & params);
-    private:
+    protected:
+        // tag-dispatched ctor for graph_mtp: binds the members without building the trunk
+        struct no_build_t {};
+        graph(const llama_model & model, const llm_graph_params & params, no_build_t) :
+            llm_build_delta_net_base(params), model(model) {}
+
         // HC replaces every layer norm: residual is [n_embd, hc, n_tokens]
         ggml_tensor * build_hc_mix(
                     ggml_tensor * x,
@@ -2033,6 +2038,11 @@ struct llama_model_qwen4exp : public llama_model_base {
         const llama_model & model;
     };
 
+    // LLM_GRAPH_TYPE_DECODER_MTP draft head: one HC-wrapped dense-attention + MoE block
+    struct graph_mtp : public graph {
+        graph_mtp(const llama_model & model, const llm_graph_params & params);
+    };
+
     std::unique_ptr<llm_graph_context> build_arch_graph(const llm_graph_params & params) const override;
 };
 
