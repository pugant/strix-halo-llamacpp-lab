From 48ea34eab314c4a057733c4a57ac584037686544 Mon Sep 17 00:00:00 2001
From: pugant <pugant@localhost>
Date: Fri, 28 Aug 2026 10:30:58 +0200
Subject: [PATCH 8/8] fix(recurrent): write the PLE conv state in
 state_write_data

state_read_data expects a p_size_row + rows block after the R rows for
layers with a PLE conv state, but the writer never emitted it, so any
restore on qwen4exp read garbage as the row size and desynced the whole
stream (first exercised by the speculative checkpoint, which is the only
user of this path on that arch)
---
 src/llama-memory-recurrent.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/llama-memory-recurrent.cpp b/src/llama-memory-recurrent.cpp
index 1c82c9906..45d9f68dc 100644
--- a/src/llama-memory-recurrent.cpp
+++ b/src/llama-memory-recurrent.cpp
@@ -899,6 +899,16 @@ void llama_memory_recurrent::state_write_data(llama_io_write_i & io, const std::
         io.write(&r_size_row, sizeof(r_size_row));
 
         write_rows(r_l[il], r_size_row);
+
+        // Write the PLE conv state right after the R rows, mirroring the order
+        // state_read_data expects (type is implicit in the reader, only the row
+        // size is round-tripped)
+        if (p_l[il] != nullptr) {
+            const uint64_t p_size_row = ggml_row_size(p_l[il]->type, hparams.ple_conv_state());
+            io.write(&p_size_row, sizeof(p_size_row));
+
+            write_rows(p_l[il], p_size_row);
+        }
     }
 
     if (!s_trans) {
