@@ -2106,6 +2138,104 @@ struct common_speculative_state_draft_mtp : public common_speculative_impl {
         return true;
     }
 
+    // t11 (b1): one fused draft round for a single drafting sequence. Builds a
+    // synthetic causal batch of n_max rows (row 0 carries the real boundary
+    // pair: dp.id_last + pending_h; the remaining rows only book KV cells and
+    // positions) and decodes it through the staged fused graph, which unrolls
+    // the whole chain in one submit. All n_max logits rows are then read back
+    // with a single sync and walked host-side with the SAME sampler calls and
+    // the SAME p_min/n_max semantics as the legacy loop, so the drafted tokens
+    // are identical for identical logits. Declared drift (content-controlled
+    // in the A/B): the chain's greedy tie-break on exact logit ties follows
+    // ggml argmax (first index) instead of the host partial_sort order, and
+    // any p_min abort wastes the already-computed tail steps (their KV cells
+    // are dropped by the existing position-based trims).
+    //
+    // Returns false when the round was NOT executed (out of the fused
+    // envelope, or the fused decode failed) after restoring the round-start
+    // batch, so the caller can fall back to the legacy per-token loop.
+    bool draft_fused(common_speculative_draft_params_vec & dparams) {
+        llama_seq_id seq_id = -1;
+        for (llama_seq_id s = 0; s < (llama_seq_id) n_seq; ++s) {
+            if (drafting[s]) {
+                seq_id = s;
+                break;
+            }
+        }
+        GGML_ASSERT(seq_id >= 0 && "draft_fused called without a drafting sequence");
+
+        auto & dp = dparams[seq_id];
+
+        const int32_t n_max = common_speculative_effective_n_max(params, dp);
+        const int32_t n_b   = (int32_t) llama_n_batch(params.ctx_dft);
+
+        if (n_max <= 0 || n_max > MTP_FUSED_MAX_STEPS || n_max > n_b) {
+            return false;
+        }
+
+        const llama_pos p_next = dp.pos_next >= 0 ? dp.pos_next : dp.n_past;
+        const size_t row_bytes = (size_t) n_embd * sizeof(float);
+
+        common_batch_clear(batch);
+
+        common_speculative_batch_add_one_seq(batch, dp.id_last, p_next, seq_id, true);
+        std::memcpy(batch.embd, pending_h[seq_id].data(), row_bytes);
+
+        for (int32_t k = 1; k < n_max; ++k) {
+            // dummy ids: the fused graph consumes only row 0 of the token input
+            common_speculative_batch_add_one_seq(batch, dp.id_last, p_next + k, seq_id, true);
+            std::memset(batch.embd + (size_t) k * n_embd, 0, row_bytes);
+        }
+
+        llama_set_mtp_draft_fused(params.ctx_dft, true);
+        const int ret = llama_decode(params.ctx_dft, batch);
+        llama_set_mtp_draft_fused(params.ctx_dft, false);
+
+        if (ret != 0) {
+            LOG_WRN("%s: fused llama_decode returned %d - falling back to the per-token loop\n", __func__, ret);
+
+            // restore the round-start batch the legacy loop expects
+            common_batch_clear(batch);
+            common_speculative_batch_add_one_seq(batch, dp.id_last, p_next, seq_id, true);
+            std::memcpy(batch.embd, pending_h[seq_id].data(), row_bytes);
+            i_last[seq_id] = batch.n_tokens - 1;
+
+            return false;
+        }
+
+        const bool log_debug = LOG_LEVEL_DEBUG <= common_log_get_verbosity_thold();
+
+        auto & result = *dp.result;
+        auto * smpl   = smpls[seq_id].get();
+
+        // host-side greedy walk: same order of operations as the legacy loop
+        // (sample top-k -> greedy id -> p_min gate -> accept -> push)
+        for (int32_t k = 0; k < n_max; ++k) {
+            const auto * cur_p = common_sampler_sample_top_k_probs(smpl, params.ctx_dft, k, MTP_DRAFT_TOP_K);
+
+            if (log_debug) {
+                for (int c = 0; c < std::min(3, (int) cur_p->size); ++c) {
+                    LOG_DBG(" - seq_id %d, draft candidate %3d, pos %3d: %6d (%8.3f) '%s'\n",
+                            seq_id, c, k, cur_p->data[c].id, cur_p->data[c].p,
+                            common_token_to_piece(params.ctx_dft, cur_p->data[c].id).c_str());
+                }
+            }
+
+            const llama_token id = cur_p->data[0].id;
+
+            if (cur_p->data[0].p < common_speculative_effective_p_min(params, dp)) {
+                n_draft_aborted++; // t11: p_min-gated head-calls (host-side truncation)
+                break;
+            }
+
+            common_sampler_accept(smpl, id, true);
+
+            result.push_back(id);
+        }
+
+        return true;
+    }
