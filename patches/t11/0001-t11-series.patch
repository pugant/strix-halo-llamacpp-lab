     void draft(common_speculative_draft_params_vec & dparams) override {
         auto & ctx_dft = params.ctx_dft;
 
@@ -2176,10 +2306,23 @@ struct common_speculative_state_draft_mtp : public common_speculative_impl {
             return;
         }
 
+        // t11 (b1): SPEC_DRAFT_FUSED collapses the round into one chained
+        // graph (see draft_fused). Envelope: a single drafting sequence, a
+        // single trained MTP head, own (non-shared) KV cache, an arch with a
+        // fused graph builder - anything else keeps the legacy per-token
+        // loop, as does any fused-decode failure.
+        bool fused_done = false;
+
+        if (common_speculative_draft_fused_enabled() &&
+                !chain_heads && !is_mem_shared && n_mtp_layers == 1 && n_drafting == 1 &&
+                llama_model_mtp_draft_fused_supported(llama_get_model(params.ctx_dft))) {
+            fused_done = draft_fused(dparams);
+        }
+
         int i = 0;
         const bool log_debug = LOG_LEVEL_DEBUG <= common_log_get_verbosity_thold();
 
-        while (n_drafting > 0) {
