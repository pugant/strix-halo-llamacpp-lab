@@ -509,6 +511,11 @@ llama_model_qwen35::graph_mtp::graph_mtp(const llama_model & model, const llm_gr
     int sections[4];
     std::copy(std::begin(hparams.rope_sections), std::begin(hparams.rope_sections) + 4, sections);
 
+    if (params.gtype == LLM_GRAPH_TYPE_DECODER_MTP_FUSED) {
+        build_fused(model, il, sections, n_embd_head);
+        return;
+    }
+
     auto inp = std::make_unique<llm_graph_input_embd>(hparams.n_embd);
 
     inp->tokens = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_tokens);
@@ -632,3 +639,263 @@ llama_model_qwen35::graph_mtp::graph_mtp(const llama_model & model, const llm_gr
     res->t_logits = cur;
     ggml_build_forward_expand(gf, cur);
 }
+
+// t11 (b1): local copy of ggml_mul_mat_aux (file-local in llama-graph.cpp) -
+// the KV-cache rotation-compensation view used by llm_graph_context::build_attn
+static ggml_tensor * ggml_mul_mat_aux_mtp(
+        ggml_context * ctx,
+        ggml_tensor * cur,
+        ggml_tensor * rot) {
+    const auto n = rot->ne[0];
+
+    ggml_tensor * res;
+
+    if (!ggml_is_contiguous(cur)) {
+        res = ggml_cont_2d   (ctx, cur, n, ggml_nelements(cur)/n);
+    } else {
+        res = ggml_reshape_2d(ctx, cur, n, ggml_nelements(cur)/n);
+    }
+    res = ggml_mul_mat   (ctx, rot, res);
+    ggml_mul_mat_set_hint(res, GGML_HINT_SRC0_IS_HADAMARD);
+    res = ggml_reshape_4d(ctx, res, cur->ne[0], cur->ne[1], cur->ne[2], cur->ne[3]);
+
+    return res;
+}
+
+// t11 (b1): the per-token MTP draft loop pays one submit+sync+readback per
+// drafted token because each step's input (greedy token id + h row) only
+// exists on the host after reading the previous step's outputs. This variant
+// unrolls the block n_tokens times inside ONE graph and keeps that wiring
+// in-graph, so a whole draft round costs a single submit+sync+readback:
+//
+//   step 0: token = batch token row 0,  h = batch embd row 0   (host inputs)
+//   step k: token = get_rows(tok_embd, argmax(logits[k-1])),   (in-graph)
+//           h     = pre-norm hidden state of step k-1           (tensor wiring)
+//
+// Each step keeps the exact shapes of the per-token graph (1-column
+// matmuls, one KV row written through the shared set_rows inputs, one
+// causal mask column), so projection kernels and the KV write path are
+// unchanged; only the number of host round-trips changes (N -> 1). ggml has
+// no data-dependent control flow, so all n_tokens steps are computed
+// unconditionally: the p_min early stop stays on the host (it truncates the
+// read-back logits rows), and the existing position-based KV trims drop
+// whatever tail cells the unused steps wrote.
+//
+// Outputs: t_logits [n_vocab, n_steps] (one column per step, gathered by the
+// out_ids input exactly like the standard graph when n_steps == n_tokens)
+// and t_h_pre_norm [n_embd, n_steps] (the per-step boundary rows the legacy
+// loop would have read back to feed the next step).
+//
+// Only row 0 of the token/embd batch inputs is consumed: the draft driver
+// submits a synthetic causal batch whose remaining rows exist to book KV
+// cells and positions through the standard find_slot/mask machinery.
+void llama_model_qwen35::graph_mtp::build_fused(const llama_model & model, int il, int * sections, int64_t n_embd_head) {
+    const auto & layer = model.layers[il];
+
+    // defensive cap: the graph must stay within the reserved node budget even
+    // if a reserve pass ever ran while the fused flag is staged (it does not,
+    // in practice - the driver only stages the flag around draft decodes)
+    const int64_t n_steps = std::min<int64_t>(n_tokens, 64);
+
+    auto inp = std::make_unique<llm_graph_input_embd>(hparams.n_embd);
+
+    inp->tokens = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_tokens);
+    ggml_set_input(inp->tokens);
+
+    inp->embd = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, hparams.n_embd, n_tokens);
+    ggml_set_input(inp->embd);
+    ggml_set_name(inp->embd, "mtp_h_input");
+
+    ggml_tensor * inp_tokens = inp->tokens;
+    ggml_tensor * h_input    = inp->embd;
+
+    ggml_tensor * tok_embd_w = layer.nextn.embed_tokens ? layer.nextn.embed_tokens : model.tok_embd;
+
+    res->add_input(std::move(inp));
+
+    ggml_tensor * inp_pos = build_inp_pos();
+    auto * inp_attn       = build_attn_inp_kv();
+
+    // step 0 inputs: the real (token, h) boundary pair from the host
+    ggml_tensor * tok = ggml_view_1d(ctx0, inp_tokens, 1, 0);
+    ggml_tensor * h_in = ggml_view_2d(ctx0, h_input, hparams.n_embd, 1, h_input->nb[1], 0);
+
+    const int64_t n_pos = hparams.n_pos_per_embd();
+
+    ggml_tensor * v_idxs_all = inp_attn->get_v_idxs();
+    const int64_t v_rows_per_tok = v_idxs_all->ne[0] / n_tokens;
+    ggml_tensor * kq_mask_all    = inp_attn->get_kq_mask();
+
+    ggml_tensor * head_norm_w = layer.nextn.shared_head_norm
+            ? layer.nextn.shared_head_norm
+            : model.output_norm;
+    GGML_ASSERT(head_norm_w && "QWEN35 MTP: missing both nextn.shared_head_norm and output_norm");
+
+    ggml_tensor * head_w = layer.nextn.shared_head_head ? layer.nextn.shared_head_head : model.output;
+    GGML_ASSERT(head_w && "QWEN35 MTP: missing LM head (nextn.shared_head_head or model.output)");
+
+    ggml_tensor * h_cat      = nullptr; // [n_embd, k+1] per-step boundary rows
+    ggml_tensor * logits_cat = nullptr; // [n_vocab, k+1] per-step logits
+
+    for (int64_t k = 0; k < n_steps; ++k) {
+        ggml_tensor * tok_embd = ggml_get_rows(ctx0, tok_embd_w, tok);
+        cb(tok_embd, "mtp_tok_embd", il);
+
+        ggml_tensor * h_norm = build_norm(h_in, layer.nextn.hnorm, nullptr, LLM_NORM_RMS, il);
+        cb(h_norm, "mtp_hnorm", il);
+
+        ggml_tensor * e_norm = build_norm(tok_embd, layer.nextn.enorm, nullptr, LLM_NORM_RMS, il);
+        cb(e_norm, "mtp_enorm", il);
+
+        ggml_tensor * concat = ggml_concat(ctx0, e_norm, h_norm, /*dim=*/ 0);
+        cb(concat, "mtp_concat", il);
+
+        ggml_tensor * cur = build_lora_mm(layer.nextn.eh_proj, concat);
+        cb(cur, "mtp_eh_proj", il);
+
+        ggml_tensor * inpSA = cur;
+
+        cur = build_norm(cur, layer.attn_norm, nullptr, LLM_NORM_RMS, il);
+        cb(cur, "mtp_attn_norm", il);
+
+        ggml_tensor * Qcur_full = build_lora_mm(layer.wq, cur, layer.wq_s);
+        cb(Qcur_full, "mtp_Qcur_full", il);
+
+        ggml_tensor * Qcur = ggml_view_3d(ctx0, Qcur_full,
+                n_embd_head, n_head, 1,
+                ggml_element_size(Qcur_full) * n_embd_head * 2,
+                ggml_element_size(Qcur_full) * n_embd_head * 2 * n_head,
+                0);
+        Qcur = build_norm(Qcur, layer.attn_q_norm, nullptr, LLM_NORM_RMS, il);
+        cb(Qcur, "mtp_Qcur_normed", il);
+
+        ggml_tensor * gate = ggml_view_3d(ctx0, Qcur_full,
+                n_embd_head, n_head, 1,
+                ggml_element_size(Qcur_full) * n_embd_head * 2,
+                ggml_element_size(Qcur_full) * n_embd_head * 2 * n_head,
+                ggml_element_size(Qcur_full) * n_embd_head);
+        gate = ggml_cont_2d(ctx0, gate, n_embd_head * n_head, 1);
+        cb(gate, "mtp_gate", il);
+
+        ggml_tensor * Kcur = build_lora_mm(layer.wk, cur, layer.wk_s);
+        Kcur = ggml_reshape_3d(ctx0, Kcur, n_embd_head, n_head_kv, 1);
+        Kcur = build_norm(Kcur, layer.attn_k_norm, nullptr, LLM_NORM_RMS, il);
+        cb(Kcur, "mtp_Kcur_normed", il);
+
+        ggml_tensor * Vcur = build_lora_mm(layer.wv, cur, layer.wv_s);
+        Vcur = ggml_reshape_3d(ctx0, Vcur, n_embd_head, n_head_kv, 1);
+        cb(Vcur, "mtp_Vcur", il);
+
+        ggml_tensor * pos_k = ggml_view_1d(ctx0, inp_pos, n_pos, k*n_pos*inp_pos->nb[0]);
+
+        Qcur = ggml_rope_multi(ctx0, Qcur, pos_k, nullptr,
+                n_rot, sections, rope_type, n_ctx_orig, freq_base, freq_scale,
+                ext_factor, attn_factor, beta_fast, beta_slow);
+        Kcur = ggml_rope_multi(ctx0, Kcur, pos_k, nullptr,
+                n_rot, sections, rope_type, n_ctx_orig, freq_base, freq_scale,
+                ext_factor, attn_factor, beta_fast, beta_slow);
+
+        // per-step attention: one KV row write + one causal mask column
+        // (mirrors llm_graph_context::build_attn for the kv-cache input)
+        const auto * mctx_cur = inp_attn->mctx;
+
+        if (inp_attn->self_k_rot) {
+            Qcur = ggml_mul_mat_aux_mtp(ctx0, Qcur, inp_attn->self_k_rot);
+            Kcur = ggml_mul_mat_aux_mtp(ctx0, Kcur, inp_attn->self_k_rot);
+        }
+
+        if (inp_attn->self_v_rot) {
+            Vcur = ggml_mul_mat_aux_mtp(ctx0, Vcur, inp_attn->self_v_rot);
+        }
+
+        // these nodes are added to the graph together so that they are not reordered
+        // by doing so, the number of splits in the graph is reduced
+        ggml_build_forward_expand(gf, Qcur);
+        ggml_build_forward_expand(gf, Vcur);
+        ggml_build_forward_expand(gf, Kcur);
+
+        {
+            ggml_tensor * k_idxs_k = ggml_view_1d(ctx0, inp_attn->get_k_idxs(), 1, k*inp_attn->get_k_idxs()->nb[0]);
+            ggml_tensor * v_idxs_k = ggml_view_1d(ctx0, v_idxs_all, v_rows_per_tok, k*v_rows_per_tok*v_idxs_all->nb[0]);
+
+            ggml_build_forward_expand(gf, mctx_cur->cpy_k(ctx0, Kcur, k_idxs_k, il));
+            ggml_build_forward_expand(gf, mctx_cur->cpy_v(ctx0, Vcur, v_idxs_k, il));
+        }
+
+        const float kq_scale = hparams.f_attention_scale == 0.0f
+                ? 1.0f / sqrtf(float(n_embd_head)) : hparams.f_attention_scale;
+
+        ggml_tensor * kq_mask_k = ggml_view_2d(ctx0, kq_mask_all,
+                kq_mask_all->ne[0], 1, kq_mask_all->nb[1], k*kq_mask_all->nb[1]);
+
+        cur = build_attn_mha(
+            /* q        */ Qcur,
+            /* k        */ mctx_cur->get_k(ctx0, il),
+            /* v        */ mctx_cur->get_v(ctx0, il),
+            /* kq_b     */ nullptr,
+            /* kq_mask  */ kq_mask_k,
+            /* sinks    */ nullptr,
+            /* v_mla    */ nullptr,
+                         kq_scale, il);
+        cb(cur, "kqv_out", il);
+
+        if (inp_attn->self_v_rot) {
+            cur = ggml_mul_mat_aux_mtp(ctx0, cur, inp_attn->self_v_rot);
+        }
+
+        cur = ggml_mul(ctx0, cur, ggml_sigmoid(ctx0, gate));
+        cur = build_lora_mm(layer.wo, cur, layer.wo_s);
+        cb(cur, "mtp_attn_out", il);
+
+        cur = ggml_add(ctx0, cur, inpSA);
+        cb(cur, "mtp_attn_residual", il);
+
+        ggml_tensor * ffn_residual = cur;
+        cur = build_norm(cur, layer.attn_post_norm, nullptr, LLM_NORM_RMS, il);
+        cb(cur, "mtp_attn_post_norm", il);
+
+        cur = build_ffn(cur,
+                layer.ffn_up,   nullptr, layer.ffn_up_s,
+                layer.ffn_gate, nullptr, layer.ffn_gate_s,
+                layer.ffn_down, nullptr, layer.ffn_down_s,
+                nullptr,
+                LLM_FFN_SILU, LLM_FFN_PAR, il);
+        cb(cur, "mtp_ffn_out", il);
+
+        cur = ggml_add(ctx0, cur, ffn_residual);
+        cb(cur, "mtp_post_ffn", il);
+
+        cur = build_norm(cur, head_norm_w, nullptr, LLM_NORM_RMS, -1);
+        cb(cur, "h_nextn", -1);
+
+        ggml_tensor * logits = build_lora_mm(head_w, cur);
+        cb(logits, "result_output", -1);
+
+        h_cat      = h_cat      ? ggml_concat(ctx0, h_cat,      cur,    /*dim=*/ 1) : cur;
+        logits_cat = logits_cat ? ggml_concat(ctx0, logits_cat, logits, /*dim=*/ 1) : logits;
+
+        if (k + 1 < n_steps) {
+            // chain the next step's inputs in-graph (the core of the fusion)
+            tok  = ggml_argmax(ctx0, logits);
+            h_in = cur;
+        }
+    }
+
+    res->t_h_pre_norm = h_cat;
+
+    ggml_tensor * out = logits_cat;
+
+    if (n_steps == n_tokens) {
+        // all fused batch rows carry logits=1, so out_ids is the identity -
+        // the gather is kept for structural parity with the standard graph
+        ggml_tensor * inp_out_ids = build_inp_out_ids();
+        out = ggml_get_rows(ctx0, logits_cat, inp_out_ids);
+    }
+
+    res->t_logits = out;
+
+    // t_h_pre_norm is not on the logits path: expand it explicitly so the
+    // concat stays in the graph (the context extracts it as an output)
+    ggml_build_forward_expand(gf, h_cat);
+    ggml_build_forward_expand(gf, out);
+}
