From 4e70bd11761e6adba769a199c9cbed96f8db78b7 Mon Sep 17 00:00:00 2001
From: pugant <pugant@local>
Date: Fri, 21 Aug 2026 14:03:44 +0200
Subject: [PATCH] feat(spec): --spec-concat-k1 flag with boot marker and guards
 [t8 stadio 2]

Config surface only for the T8 stage 2 concat round mode (MTP k1 tokens
+ DFlash block in one verify) - no round mechanics yet (Task 4).

- common.h: speculative.concat_k1 (int32_t, default 0 = off; valid range
  0..6: k1 + dflash n_max 7 + 1 verify token = 14 columns, within the
  16-column dmmv cap of the patched Vulkan backend)
- arg.cpp: --spec-concat-k1 N; out-of-range values are rejected with a
  descriptive std::invalid_argument, aligned with the bounded-int spec
  flag pattern (--spec-ngram-mod-n-min; --spec-draft-n-max uses the same
  throw for negative values; no spec flag clamps with a warning)
- server-context.cpp: boot guard next to the existing dual-mode markers -
  k1 > 0 with dual routing and both draft-mtp and draft-dflash
  instantiated logs "spec-route: concat mode k1=<n>" (INFO); k1 > 0
  without those conditions (single type, boot-degraded dual) keeps the
  T7 routing with a WARNING, never a boot error (spec section 10)
- k1 = 0 (default) leaves the T7 behavior untouched: the boot guard is
  the only consumer of the new field

Verified with scripts/t8-concat-t1.sh (T7 T1 suite copy kept verbatim as
regression backbone + 12 new boot checks): red run 9 FAIL pre-change
(logs/test-t8-concat/t3-flag-fail.log), green run 26/26 PASS
(t3-flag-pass.log).

Co-Authored-By: GLM by z.ai <glm@z.ai>
---
 common/arg.cpp                  | 10 ++++++++++
 common/common.h                 |  7 +++++++
 tools/server/server-context.cpp | 21 +++++++++++++++++++++
 3 files changed, 38 insertions(+)

diff --git a/common/arg.cpp b/common/arg.cpp
index 816709772..3ea818d3d 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -3654,6 +3654,16 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             params.speculative.types.insert(params.speculative.types.end(), types.begin(), types.end());
         }
     ).set_spec().set_examples({LLAMA_EXAMPLE_SPECULATIVE, LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_CLI}).set_env("LLAMA_ARG_SPEC_TYPE"));
+    add_opt(common_arg(
+        {"--spec-concat-k1"}, "N",
+        string_format("number of MTP tokens chained before the draft-dflash block in a concat round of dual routing, 0 = off (default: %d)", params.speculative.concat_k1),
+        [](common_params & params, int value) {
+            if (value < 0 || value > 6) {
+                throw std::invalid_argument("spec concat k1 must be between 0 and 6 inclusive");
+            }
+            params.speculative.concat_k1 = value;
+        }
+    ).set_spec().set_examples({LLAMA_EXAMPLE_SPECULATIVE, LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_CLI}).set_env("LLAMA_ARG_SPEC_CONCAT_K1"));
     add_opt(common_arg(
         {"--spec-ngram-mod-n-min"}, "N",
         string_format("minimum number of ngram tokens to use for ngram-based speculative decoding (default: %d)", params.speculative.ngram_mod.n_min),
diff --git a/common/common.h b/common/common.h
index 09fb29b25..7104ed292 100644
--- a/common/common.h
+++ b/common/common.h
@@ -355,6 +355,13 @@ struct common_params_speculative {
     bool mtp_strict = true;
     bool mtp_strict_qwen = false;
 
+    // t8 stadio 2: MTP tokens chained before the draft-dflash block in a concat
+    // round of dual routing. 0 = off (default) - no concat code path runs and the
+    // behavior is identical to the T7 dual routing. Valid range 0..6: a concat
+    // round verifies k1 + dflash n_max (7) + 1 token = at most 14 columns, within
+    // the 16-column dmmv cap of the patched Vulkan backend.
+    int32_t concat_k1 = 0;
+
     // used by Simple, MTP, Eagle3, etc. - all methods that require some kind of draft model
     common_params_speculative_draft draft;
 
diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 97b604dd0..f8d87e4f7 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -1317,6 +1317,27 @@ private:
             }
         }
 
+        // t8 stadio 2 (spec §3 'Boot'): --spec-concat-k1 > 0 arms the concat
+        // round mode (MTP k1 tokens + the draft-dflash block in one verify).
+        // Config surface only for now - no round mechanics: the marker just
+        // confirms the boot guard. concat requires dual routing with BOTH
+        // draft-mtp and draft-dflash actually instantiated (a dual config that
+        // degraded to mono at boot counts as not ready, and so does any
+        // single-type server): anything else keeps the T7 routing with a
+        // WARNING, never a boot error (spec §10).
+        if (params_base.speculative.concat_k1 > 0) {
+            const bool concat_ready = spec_dual
+                && spec_types_loaded.count(COMMON_SPECULATIVE_TYPE_DRAFT_MTP) > 0
+                && spec_types_loaded.count(COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH) > 0;
+
+            if (concat_ready) {
+                SRV_INF("spec-route: concat mode k1=%d\n", params_base.speculative.concat_k1);
+            } else {
+                SRV_WRN("spec-route: concat mode disabled: --spec-concat-k1 %d requires dual routing (draft-mtp,draft-dflash) with both drafters loaded - keeping the T7 routing\n",
+                        params_base.speculative.concat_k1);
+            }
+        }
+
         for (int i = 0; i < params_base.n_parallel; i++) {
             server_slot & slot = slots[i];
 
