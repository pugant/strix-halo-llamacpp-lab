From 8cf1eac741f3437c27b8283ffe2e51bb262a2e90 Mon Sep 17 00:00:00 2001
From: pugant <pugant@local>
Date: Fri, 21 Aug 2026 18:08:49 +0200
Subject: [PATCH] spec: fix width-groups marker semantics and harden concat
 accept trim [t8 stadio 2]

Quality-review fixes for the Task 5 commit (2 Important + 3 Minor):

Important 1: the "width groups" marker tested `h - g > 1` INSIDE the
per-group loop - that is the same-width case (2+ sequences converge in ONE
decode), so a real split (two singleton width groups) never fired it and
T5g passed on a false positive. Count the DISTINCT widths before the
grouping loop and log once at the first group when n_width_groups > 1,
with an accurate message. T5g now asserts the real firing: concurrent
boot logs "dflash decode split into 2 width groups (n_seqs=2)".

Important 2: the accept-time draft-context trim comment argued by
arithmetic coincidence with the server's rollback bound; reformulated on
the invariant instead: it never trims below pending_h_pos (the freshest
valid row), and in concat rounds it is the ONLY trim of this context (the
server rollback trims the closing arm's context only) - removing it
reintroduces the KV-contiguity runaway (dispatch-only image d3bdf3497f46
evidence in logs/test-t8-concat/t5-dormancy-numbers.txt).

Minor 3: llama_memory_seq_rm() returning false in the accept-time trim is
now warned about (a silent failure would reintroduce the runaway
invisibly); no abort - the common_context_seq_rm wrapper is too
aggressive for this best-effort reconciliation.

Minor 4: documented the replay residual next to the wholesale impl_head
clear - a replayed round between draft() and accept() loses its head
contributor (benign dormancy, resync at the next full acceptance).

Minor 5: renamed the shadowing local impl_head to impl_contrib in
common_speculative_accept().

t8-concat-t2.sh on the rebuilt image: 20/20 (real split marker, zero
position errors, containers clean).

Co-Authored-By: GLM by z.ai <glm@z.ai>
---
 common/speculative.cpp | 72 +++++++++++++++++++++++++++---------------
 1 file changed, 47 insertions(+), 25 deletions(-)

diff --git a/common/speculative.cpp b/common/speculative.cpp
index f1ad5ce74..f6ee143f6 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -1505,6 +1505,20 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
             return n_rows[a] < n_rows[b];
         });
 
+        // t8 stadio 2 (Task 5 test coverage): count the DISTINCT round widths in
+        // this decode BEFORE the grouping loop - one group holding 2+ sequences
+        // is the same-width case (the former one-decode flow), while a real
+        // split (e.g. a composed concat round next to a plain block) shows up
+        // as multiple single-width groups. The first real split is logged once
+        // at INFO so the concurrency smoke tests can assert the grouped decode
+        // path actually ran.
+        size_t n_width_groups = 0;
+        for (size_t s = 0; s < seqs.size(); ++s) {
+            if (s == 0 || n_rows[seqs[s]] != n_rows[seqs[s - 1]]) {
+                n_width_groups++;
+            }
+        }
+
         size_t g = 0;
         while (g < seqs.size()) {
             size_t h = g;
@@ -1512,16 +1526,12 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
                 ++h;
             }
 
-            // t8 stadio 2 (Task 5 test coverage): this decode carries more than
-            // one round width (e.g. a composed concat round next to a plain
-            // block) - the width-grouped path runs; log once at INFO so the
-            // concurrency smoke tests can assert the path was exercised
-            if (h - g > 1) {
+            if (g == 0 && n_width_groups > 1) {
                 if (!width_split_logged) {
-                    SPC_INF("dflash decode split into %zu width groups (mixed plain/concat rounds)\n", h - g);
+                    SPC_INF("dflash decode split into %zu width groups (n_seqs=%zu)\n", n_width_groups, seqs.size());
                     width_split_logged = true;
                 } else {
-                    SPC_DBG("dflash decode split into %zu width groups (mixed plain/concat rounds)\n", h - g);
+                    SPC_DBG("dflash decode split into %zu width groups (n_seqs=%zu)\n", n_width_groups, seqs.size());
                 }
             }
 
@@ -2293,19 +2303,28 @@ struct common_speculative_state_draft_mtp : public common_speculative_impl {
 
         // t8 stadio 2 (spec §3, Task 5): reconcile this impl's draft context with
         // the accepted boundary. A partially accepted round leaves the mirrored
-        // verify rows of the rejected tail in ctx_dft; when another drafter
-        // closed the round the server's trailing rollback only trims the ACTIVE
-        // drafter's context (the head contributor's one is trimmed later, at the
-        // next draft phase) - so the stale tail survives any path that skips the
-        // draft phase (e.g. the plain single-token decode at n_predict
-        // exhaustion), and the next process() mirror then fails the KV position
-        // contiguity check (Y = X + 1) and derails the request. Trimming here
-        // mirrors what the server does for the active drafter's context at the
-        // same boundary (mono-MTP rounds hit that trim: this one is idempotent
-        // with it). Gemma4 assistants share the draft context with the target:
-        // there the server trim already covers it, keep out.
+        // verify rows of the rejected tail in ctx_dft. Invariant: this never
+        // trims below pending_h_pos (the freshest valid row), so the next
+        // process()/draft() always mirrors contiguously from there. In concat
+        // rounds this is the ONLY trim of this context - the server's rollback
+        // (server-context.cpp:4254-4257) trims the closing arm's context only,
+        // and the harness's draft-phase trim of the other context is skipped by
+        // any iteration that does not draft (e.g. the plain single-token decode
+        // at n_predict exhaustion): without this trim the stale tail fails the
+        // KV position contiguity check (Y = X + 1) and derails the request into
+        // the error loop (dispatch-only image d3bdf3497f46 evidence in
+        // logs/test-t8-concat/t5-dormancy-numbers.txt). Gemma4 assistants share
+        // the draft context with the target: the server trim covers them, keep
+        // out.
         if (!is_mem_shared) {
-            llama_memory_seq_rm(llama_get_memory(params.ctx_dft), seq_id, pending_h_pos[seq_id] + 1, -1);
+            if (!llama_memory_seq_rm(llama_get_memory(params.ctx_dft), seq_id, pending_h_pos[seq_id] + 1, -1)) {
+                // t8: a silent failure here would reintroduce the KV-contiguity
+                // runaway invisibly - warn loudly instead (no abort: the
+                // aggressive common_context_seq_rm wrapper is not appropriate
+                // for this best-effort reconciliation)
+                SPC_WRN("draft-context trim to the accepted boundary failed (seq %d, pos=%d)\n",
+                        (int) seq_id, (int) (pending_h_pos[seq_id] + 1));
+            }
         }
 
         // all verification rows are valid boundary candidates at their
@@ -3545,7 +3564,10 @@ void common_speculative_draft(common_speculative * spec) {
         int n_drafting = 0;
 
         // t8 concat (Task 5): a new round starts - drop any head contributor
-        // left over from a round that was never accepted (lost round)
+        // left over from a round that was never accepted (lost round). A
+        // replayed round between draft() and accept() also loses its head
+        // contributor this way: benign dormancy, resync at the next full
+        // acceptance.
         std::fill(spec->impl_head.begin(), spec->impl_head.end(), nullptr);
 
         for (auto & dp : dparams) {
@@ -3798,14 +3820,14 @@ void common_speculative_accept(common_speculative * spec, llama_seq_id seq_id, u
         impl->n_call_accept++;
     }
 
-    common_speculative_impl * impl_head = spec->impl_head[seq_id];
+    common_speculative_impl * impl_contrib = spec->impl_head[seq_id];
     spec->impl_head[seq_id] = nullptr;
 
-    if (impl_head != nullptr && impl_head != impl) {
-        common_time_meas tm(impl_head->t_accept_us, !impl_head->gen_perf);
+    if (impl_contrib != nullptr && impl_contrib != impl) {
+        common_time_meas tm(impl_contrib->t_accept_us, !impl_contrib->gen_perf);
 
-        impl_head->accept(seq_id, n_accepted);
-        impl_head->n_call_accept++;
+        impl_contrib->accept(seq_id, n_accepted);
+        impl_contrib->n_call_accept++;
     }
 }
 
