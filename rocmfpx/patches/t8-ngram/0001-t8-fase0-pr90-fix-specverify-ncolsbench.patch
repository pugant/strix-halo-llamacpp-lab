diff --git a/tools/ncols-bench/ncols-bench.cpp b/tools/ncols-bench/ncols-bench.cpp
index f482168e3..64055f075 100644
--- a/tools/ncols-bench/ncols-bench.cpp
+++ b/tools/ncols-bench/ncols-bench.cpp
@@ -91,7 +91,7 @@ bool cpu_reference(const void * qa, const float * hb, int ncols, std::vector<flo
