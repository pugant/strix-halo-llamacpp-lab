+    // t9 fase A (Task 5): pre-misura del round r+1 con drafter DF7 sul contesto
+    // C_{r+1} appena committato. Precondizioni (chiamante - Task 6):
+    // spec_shadow_on && slot.is_processing() && round committato (riga C già
+    // scritta). NON passa da common_speculative_draft(): impl_last/impl_head e
+    // i flag drafting live restano del round vero -> accept() del round vero
+    // invariato.
+    //
+    // Cosa NON tocca: slot.prompt.tokens, cache prompt, impl_last/impl_head,
+    // slot.smpl (clone only), contatori metriche del round vero (n_draft_*),
+    // spec_dists. spec_ckpt viene sovrascritto da update_tgt/load_tgt SOLO su
+    // memoria FULL: il round vero lo ri-snapshotta alla prossima draft phase
+    // (dopo un commit spec_draft è vuoto -> path fresh, mai il riuso parziale),
+    // quindi il checkpoint del round reale non è mai consumato dallo shadow.
+    //
+    // Semantica di misura dichiarata: DF "sempre attivo" - lo stato interno
+    // dell'impl DF (smpls per-seq, selector_rng, contatori per-impl) avanza con
+    // gli shadow draft; ininfluente sul round vero (temp 0, e il routing di
+    // questa seq resta MTP). Limite dichiarato: non replica il cap
+    // strict_qwen_mtp_verification (padding 256 celle) sul chain DF - in quel
+    // mode la E_D misurata può sovrastimare quella di un round DF reale quando
+    // il chain attraversa un boundary di blocco.
+    //
+    // Segmenti della riga S: draft_us = helper DF (igiene trim + draft DF);
+    // prep_us = build verify batch + snapshot ckpt tgt (FULL) + snapshot stato
+    // impl; accept_us = decode tgt + process (mirror DF/MTP) + accept greedy su
+    // sampler clonato; rollback_us = restore ckpt (FULL) + trim dei TRE
+    // contesti + restore stato impl.
+    void shadow_drafter_round(server_slot & slot) {
+        // dp shadow = dp del round vero con override. Copia by-value dalla dp
+        // live: il round vero la riscrive per intero alla prossima draft phase
+        // (assegnazione posizionale in update_slots), nessun refresh serve.
+        common_speculative_draft_params dp = common_speculative_get_draft_params(spec.get(), slot.id);
+        dp.drafting    = true;
+        dp.drafter     = COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH;
+        dp.n_max       = SHADOW_N_MAX_DF;
+        dp.pos_next    = slot.prompt.tokens.pos_next(); // = boundary C_{r+1}
+        dp.id_last     = slot.sampled;                  // bonus token del round r
+        dp.n_past      = slot.prompt.n_tokens();        // come il round vero (pos dell'ancora)
+        dp.result      = &slot.shadow_draft_buf;
+        dp.dists       = nullptr;    // accettazione greedy (no spec-dists)
+        dp.temperature = 0.0f;       // greedy: soddisfa l'assert dflash2 (temperature<=0 || dists)
+        dp.concat_head = nullptr;    // mai una testa concat in un round shadow
+        slot.shadow_draft_buf.clear();
+
+        // t0 apre il segmento draft_us DOPO il setup dp: il contratto dei
+        // segmenti (commento sopra) dichiara draft_us = solo helper DF (setup
+        // no-GPU, microsecondi, fuori misura). df_pos_bnd = boundary del ctx DF
+        // restituito dall'helper: pairing esplicito con il rollback (3).
+        const int64_t t0 = ggml_time_us();
+        llama_pos df_pos_bnd = 0;
+
+        const int n_df = common_speculative_shadow_draft_dflash(spec.get(), slot.id, dp, df_pos_bnd);
+        const int64_t t1 = ggml_time_us();
+
+        int e_d = 0;
+        if (n_df > 0) {
+            // ---- verify: 1 + n_df righe su ctx_tgt, pattern del ramo spec di
+            // update_batch() (ancora = sampled @ pos_next, poi la chain)
+            common_batch_clear(slot.shadow_batch);
+            llama_pos pos0 = slot.prompt.tokens.pos_next();
+            slot.shadow_i_batch.clear();
+            common_batch_add(slot.shadow_batch, slot.sampled, pos0++, { slot.id }, true);
+            slot.shadow_i_batch.push_back(slot.shadow_batch.n_tokens - 1);
+            for (const auto tok : slot.shadow_draft_buf) {
+                common_batch_add(slot.shadow_batch, tok, pos0++, { slot.id }, true);
+                slot.shadow_i_batch.push_back(slot.shadow_batch.n_tokens - 1);
+            }
+
+            // snapshot ckpt target PRIMA del decode, SOLO per memoria FULL
+            // (seq_rm parziale assente: il rollback passa dal restore by-value).
+            // PART/RS escono dal verify con un append-only di <= 8 righe, entro
+            // il floor RS -> il trim diretto al rollback basta. Tipo gestito da
+            // questo full_mem: SOLO FULL (NO non può capitare: senza seq_rm il
+            // server non arma la speculazione in load_model).
+            const bool full_mem = ctx_tgt_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_FULL;
+            if (full_mem) {
+                slot.spec_ckpt.update_tgt(ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY | LLAMA_STATE_SEQ_FLAGS_ON_DEVICE);
+            }
+
+            // snapshot dello stato impl (boundary MTP) da ripristinare a fine
+            // shadow: il mirror MTP è UNGATED e ingerisce le righe shadow,
+            // avanzando pending_h oltre il boundary committato - senza restore
+            // il draft MTP del round vero r+1 si spegne ("boundary pos mismatch"
+            // in impl draft-mtp). Stesso meccanismo get_state/set_state del
+            // restore post-checkpoint del round vero.
+            std::vector<uint8_t> shadow_spec_state;
+            const bool need_spec_state = common_speculative_state_required(spec.get());
+            if (need_spec_state && !common_speculative_get_state(spec.get(), slot.id, shadow_spec_state)) {
+                // il restore finale salta il blob vuoto: il round vero r+1
+                // potrebbe ripartire da un boundary neutro (draft MTP degradato
+                // per un giro) - non silenzioso, scremabile dai log
+                SLT_WRN(slot, "%s", "shadow round: impl-state snapshot failed - restore skipped, next real MTP draft may resync\n");
+            }
+            const int64_t t2 = ggml_time_us();
+
+            if (llama_decode(slot.ctx_tgt, slot.shadow_batch) == 0) {
+                common_speculative_process(spec.get(), slot.shadow_batch); // mirror DF (gate Task 4) + MTP ungated
+
+                // accept greedy su sampler CLONATO (il clone prende/ritorna raw
+                // ptr): slot.smpl avanza SOLO col round vero
+                common_sampler_ptr smpl_shadow(common_sampler_clone(slot.smpl.get()));
+                const auto accepted = common_sampler_sample_and_accept_n(smpl_shadow.get(), slot.ctx_tgt,
+                                        slot.shadow_i_batch, slot.shadow_draft_buf,
+                                        /*grammar_first=*/false, /*shadow=*/true);
+                // mai abort su un round di misura; il contratto del sampler garantisce >= 1
+                e_d = std::max(0, (int) accepted.size() - 1);
+            } else {
+                // e_d=0 registrato, indistinguibile da un full reject nelle sole
+                // righe S: questo WRN permette di scremare il run dall'analisi
+                SLT_WRN(slot, "%s", "shadow round: verify decode failed - e_d=0 recorded (indistinguishable from full reject)\n");
+            }
+            const int64_t t3 = ggml_time_us();
+
+            // ---- rollback: TRE contesti al boundary C_{r+1}
+            if (full_mem) {
+                const bool restored_tgt = slot.spec_ckpt.load_tgt(slot.ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY | LLAMA_STATE_SEQ_FLAGS_ON_DEVICE);
+                if (!restored_tgt) {
+                    // misura best-effort: il decode è append-only, il trim sotto
+                    // rimuove comunque tutte le righe shadow; il round vero
+                    // ri-snapshotta il ckpt alla prossima draft phase
+                    SLT_WRN(slot, "%s", "shadow round: speculative checkpoint restore failed (target) - trimming only\n");
