+// check. fflush a ogni riga (pattern SPEC_VERIFY_LOG in common/sampling.cpp e T7).
+static FILE * spec_shadow_log_file = nullptr;
+static void spec_shadow_log(const char * fmt, ...) {
+    if (spec_shadow_log_file == nullptr) {
+        const char * path = getenv("SPEC_SHADOW_LOG");
+        if (!path || !path[0]) { spec_shadow_log_file = (FILE *) -1; return; } // sentinella: disabled
