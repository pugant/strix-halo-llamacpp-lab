+// > 0, altrimenti resta intatto - il chiamante lo ripassa tale e quale a
+// common_speculative_shadow_rollback_dflash() per chiudere il round shadow
+// (pairing esplicito chiamante→chiamato: nessuno stato nascosto nella struct
+// e nessun accoppiamento implicito fra round diversi). Lo stato interno
+// dell'impl DF (smpls per-seq, selector_rng) avanza col round shadow: drift
+// accettato e dichiarato (solo diagnostico).
+int common_speculative_shadow_draft_dflash(struct common_speculative * spec,
+                                            llama_seq_id seq_id,
+                                            common_speculative_draft_params & dp,
+                                            llama_pos & pos_bnd_out);
+
+// T9 Fase A (Task 5): trim best-effort del KV del SOLO contesto DFlash
+// (dell'impl) oltre pos_bnd, il boundary restituito da common_speculative_
+// shadow_draft_dflash() per lo STESSO round shadow (il server non vede il
+// ctx DF). Rimuove eventuali residui del noise block e il mirror DF delle
+// righe verify shadow. Best-effort: WRN sul fallimento, mai abort.
+void common_speculative_shadow_rollback_dflash(struct common_speculative * spec,
+                                                llama_seq_id seq_id,
+                                                llama_pos pos_bnd);
+
 // true if any implementation requires target post-norm embeddings to be extracted
 bool common_speculative_need_embd(common_speculative * spec);
 
