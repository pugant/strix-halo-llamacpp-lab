+            fprintf(stderr, "spec-shadow: cannot open SPEC_SHADOW_LOG '%s': %s\n", path, strerror(errno));
+            spec_shadow_log_file = (FILE *) -1;
+            return;
+        }
+    }
+    if (spec_shadow_log_file == (FILE *) -1) return;
+    va_list ap;
+    va_start(ap, fmt);
+    vfprintf(spec_shadow_log_file, fmt, ap);
+    va_end(ap);
+    fflush(spec_shadow_log_file);
+}
