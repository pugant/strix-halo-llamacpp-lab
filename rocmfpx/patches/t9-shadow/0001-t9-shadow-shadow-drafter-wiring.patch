index a2529b500..fe2c5c9a8 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -1206,7 +1206,12 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
             const common_speculative_type drafter = (*dparams_routing)[seq_id].drafter;
             if (drafter != COMMON_SPECULATIVE_TYPE_NONE && drafter != type) {
                 // this sequence is drafted by another implementation and never
-                // advances in this context - the pos_max check below would always trip
+                // advances in this context via the real-round draft path - the
+                // pos_max check below still only guards that path. (t9 fase A:
+                // with the shadow mirror armed (g_spec_shadow_armed) process()
+                // DOES ingest this sequence here, so the context can advance -
+                // begin() keeps skipping the selector reset and the check,
+                // which only matters for sequences this impl drafts for real)
                 return;
             }
         }
@@ -3616,6 +3621,122 @@ void common_speculative_set_shadow(bool armed) {
     g_spec_shadow_armed = armed;
 }
 
+// t9 fase A (Task 5): l'impl draft-dflash, stesso criterio del concat/dispatcher
+// in common_speculative_draft() (itera spec->impls per type). Nota: DSpark non è
+// un'implementazione separata qui - condivide la struct con DFlash via il
+// parametro type del ctor - quindi il confronto sul type è quello giusto.
+// Ritorna direttamente il tipo concreto: i due helper shadow leggono
+// params.ctx_dft senza cast nei caller.
+static common_speculative_impl_draft_dflash * common_speculative_find_dflash(common_speculative * spec) {
+    for (auto & impl : spec->impls) {
+        if (impl->type == COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH) {
+            return static_cast<common_speculative_impl_draft_dflash *>(impl.get());
+        }
+    }
+    return nullptr;
+}
+
+int common_speculative_shadow_draft_dflash(
+        common_speculative * spec,
+        llama_seq_id seq_id,
+        common_speculative_draft_params & dp,
+        llama_pos & pos_bnd_out) {
+    if (spec == nullptr) {
+        return 0;
+    }
+
+    auto * impl_df = common_speculative_find_dflash(spec);
+    if (impl_df == nullptr || impl_df->draft_n_max() <= 0) {
+        return 0;
+    }
+
+    GGML_ASSERT(seq_id >= 0 && seq_id < (llama_seq_id) spec->dparams.size());
+    GGML_ASSERT(dp.result != nullptr);
+
+    auto * ctx_dft = impl_df->params.ctx_dft;
+    auto * mem_dft = llama_get_memory(ctx_dft);
+
+    // igiene pre-draft: il mirror armato (Task 4) ingerisce nel ctx DF l'INTERO
+    // batch di verify del round vero, coda rifiutata inclusa, quindi pos_max può
+    // stare OLTRE il boundary committato C_{r+1} (= dp.n_past). Il noise block
+    // del draft shadow ancora l'ancora a dp.n_past e non deve trovare righe
+    // stantie a quelle posizioni: trim best-effort al boundary (pattern del
+    // trim di accept() MTP, qui è codice di misura - mai abort), il prefisso
+    // committato del mirror (pos < dp.n_past) resta.
+    if (!llama_memory_seq_rm(mem_dft, seq_id, dp.n_past, -1)) {
+        SPC_WRN("shadow draft: dflash-context trim to the committed boundary failed (seq %d, pos=%d)\n",
+                (int) seq_id, (int) dp.n_past);
+    }
+
+    // boundary KV DF pre-draft, dopo il trim: in condizioni normali
+    // dp.n_past - 1 (tutto il mirror committato e nulla oltre). Esce come
+    // OUT param SOLO se il round produce una chain (vedi il contratto in
+    // speculative.h) - nessuno stato nella struct.
+    const llama_pos pos_bnd = llama_memory_seq_pos_max(mem_dft, seq_id);
+
+    // vec per-seq a dimensione piena: impl->draft() indicizza dparams[seq_id]
+    // per ogni seq in [0, n_seq), quindi una vec di una sola entry andrebbe out
+    // of bounds con n_seq > 1. Le altre seq restano drafting=false (tra un round
+    // e l'altro i flag live sono tutti falsi: il dispatcher li azzera a fine
+    // draft) e i loro campi non vengono mai letti. La nostra entry è la copia
+    // del caller con gli override shadow.
+    common_speculative_draft_params_vec vec(spec->dparams.size());
+    {
+        auto & sdp = vec[seq_id];
+        sdp = dp;
+        sdp.drafting   = true;
+        sdp.drafter    = COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH;
+        sdp.concat_head = nullptr; // mai una testa concat in un round shadow
+    }
+
+    // chiamata diretta (niente dispatcher): impl_last/impl_head, attribuzione
+    // del round e reset dei flag live restano del round vero. I contatori
+    // per-impl dell'impl DF (n_call_draft, t_draft_us, smpls, selector_rng)
+    // avanzano col round shadow: drift dichiarato, solo diagnostica (il round
+    // vero di questa seq è temp 0 e non dipende da quello stato).
+    impl_df->draft(vec);
+
+    // trim immediato del noise block (pos > pos_bnd): la chain è già estratta
+    // da draft(), quelle righe KV non servono più - e il mirror di
+    // common_speculative_process() sulle righe verify shadow deve decodificare
+    // alle STESSE posizioni senza trovarle occupate (pattern del round vero:
+    // restore/trim del ctx del drafter PRIMA del verify decode). Anche con
+    // chain vuota (n_min/p_min clear) il noise block è stato decodificato e va
+    // rimosso. Best-effort come il pre-trim: WRN, mai abort.
+    if (!llama_memory_seq_rm(mem_dft, seq_id, pos_bnd + 1, -1)) {
+        SPC_WRN("shadow draft: dflash-context noise-block trim failed (seq %d, pos=%d)\n",
+                (int) seq_id, (int) (pos_bnd + 1));
+    }
+
+    if (!dp.result->empty()) {
+        pos_bnd_out = pos_bnd;
+    }
+
+    return (int) dp.result->size();
+}
+
+void common_speculative_shadow_rollback_dflash(common_speculative * spec, llama_seq_id seq_id, llama_pos pos_bnd) {
+    if (spec == nullptr) {
+        return;
+    }
+
+    auto * impl_df = common_speculative_find_dflash(spec);
+    if (impl_df == nullptr) {
+        return;
+    }
+
+    auto * ctx_dft = impl_df->params.ctx_dft;
+
+    // best-effort (pattern del pre-trim gemello in shadow_draft_dflash): il
+    // round vero ripristina questo contesto per conto suo al prossimo draft,
+    // ma un fallimento silenzioso qui lascerebbe le righe mirror shadow nel
+    // ctx DF - WRN, mai abort in un round di misura.
+    if (!llama_memory_seq_rm(llama_get_memory(ctx_dft), seq_id, pos_bnd + 1, -1)) {
+        SPC_WRN("shadow rollback: dflash-context trim past the shadow boundary failed (seq %d, pos=%d)\n",
+                (int) seq_id, (int) (pos_bnd + 1));
+    }
+}
+
 bool common_speculative_process(common_speculative * spec, const llama_batch & batch) {
     bool result = true;
 
