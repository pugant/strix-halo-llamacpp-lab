+                    (!spec_dual || spec_types_loaded.count(COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH) == 0)) {
+                SRV_ERR("spec-t9ci: mode requires dual routing with the draft-dflash implementation loaded (spec_dual=%d dflash=%d) - aborting\n",
+                        (int) spec_dual,
+                        (int) (spec_types_loaded.count(COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH) > 0));
+                return false;
+            }
+
+            // marker uno-per-boot (il controller grep-a 'spec-t9ci: mode=' == 1)
+            SRV_INF("spec-t9ci: mode=%s (env %s)\n",
+                    t9ci_mode == spec_t9ci_mode::noise     ? "noise"     :
+                    t9ci_mode == spec_t9ci_mode::draftonly ? "draftonly" :
+                    t9ci_mode == spec_t9ci_mode::shadow    ? "shadow"    : "off",
+                    t9ci_mode == spec_t9ci_mode::noise     ? "SPEC_T9_NOISE_DECODE=1" :
+                    t9ci_mode == spec_t9ci_mode::draftonly ? "SPEC_T9_DRAFT_ONLY=1"  :
+                    t9ci_mode == spec_t9ci_mode::shadow    ? "SPEC_SHADOW_DRAFT=1"   : "none");
+
+            // t9 fase A (Task 4) + t9 charidentity (B2): arma il mirror DF del
+            // process() gate (speculative.cpp) per OGNI modalità attiva, E1/E2
+            // compresi - senza mirror armato il ctx DF della seq MTP-routed è
