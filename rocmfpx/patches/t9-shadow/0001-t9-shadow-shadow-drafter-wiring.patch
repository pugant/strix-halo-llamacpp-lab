+                        shadow_drafter_round(slot);
+                    }
                 }
             }
 
@@ -4615,8 +4681,18 @@ private:
                 // > 0 che specchia la C). Nota qui: il giro che termina la
                 // request esce col break/release dentro il loop ids sopra ->
                 // is_processing() false -> S saltata, coerente con la C mancante.
-                if (spec_shadow_on && slot.is_processing() && slot.n_spec_rounds > 0) {
-                    shadow_drafter_round(slot);
+                // t9 charidentity: dispatch per modalità (R4: ENTRAMBI i siti;
+                // precedenza noise > draftonly > shadow - mutuamente esclusive
+                // per costruzione, il boot fa fail-stop sul conflitto). Primo
+                // check cheap: mode off = nessuna chiamata, path identico a oggi.
+                if (t9ci_mode != spec_t9ci_mode::off && slot.is_processing() && slot.n_spec_rounds > 0) {
+                    if (t9ci_mode == spec_t9ci_mode::noise) {
+                        noise_decode_round(slot);
+                    } else if (t9ci_mode == spec_t9ci_mode::draftonly) {
+                        draft_only_round(slot);
+                    } else if (spec_shadow_on) {
+                        shadow_drafter_round(slot);
+                    }
                 }
             }
         }
@@ -4805,6 +4881,153 @@ private:
         }
     }
 
+    // t9 charidentity (E1, SPEC_T9_NOISE_DECODE): braccio di isolamento H1 - un
+    // decode extra interleaved su ctx_tgt con contenuto DUMMY fisso (ancora +
+    // 7 copie di slot.sampled) e rollback COMPLETO al boundary C_{r+1}.
+    // Semantica dichiarata: E1 = ON (shadow_drafter_round) meno {draft DF,
+    // accept, righe variabili} - batch fisso a 8 righe (la capacità allocata
+    // del batch verify), NESSuna chiamata al draft DF, NESSun token accettato.
+    // Cosa NON tocca (parità con lo shadow): slot.prompt.tokens, cache prompt,
+    // impl_last/impl_head, slot.smpl (mai campionato), contatori del round vero,
+    // spec_dists. Il mirror DF resta ARMATO (boot, B2): il process() sotto guard
+    // ingerisce le righe noise nel ctx DF e il rollback le ripulisce.
+    //
+    // Segmenti della riga N: decode_us copre il round E1 per intero (igiene DF +
+    // build batch + snapshot ckpt/stato + decode + process); il rollback finale
+    // resta FUORI misura (contratto della riga: solo decode_us).
+    void noise_decode_round(server_slot & slot) {
+        const int64_t t0 = ggml_time_us();
+
+        const llama_pos pos_next = slot.prompt.tokens.pos_next(); // = boundary C_{r+1}
+
+        // igiene PRE-decode del ctx DF: il mirror armato ha ingerito nel ctx DF
+        // anche la coda RIFIUTATA del round vero, che siede a pos >= pos_next -
+        // senza questo trim il mirror decodificherebbe le righe noise su
+        // posizioni occupate (KV duplicato), cosa che ON non fa (laggiù il
+        // pre-trim vive dentro shadow_draft_dflash, prima del noise block). Il
+        // ctx DF è opaco per il server: si riusa l'helper esposto, che trima da
+        // pos_bnd+1 - pos_next-1 = trim da pos_next.
+        common_speculative_shadow_rollback_dflash(spec.get(), slot.id, pos_next - 1);
+
+        // batch fisso 8 righe dummy: ancora (sampled) + 7 copie, pos consecutive
+        // da pos_next. shadow_i_batch resta VUOTO: niente accept, gli indici non
+        // servono. Capacità allocata = 1 + SHADOW_N_MAX_DF = 8 righe esatte.
+        common_batch_clear(slot.shadow_batch);
+        llama_pos pos0 = pos_next;
+        for (int i = 0; i < 1 + SHADOW_N_MAX_DF; ++i) {
+            common_batch_add(slot.shadow_batch, slot.sampled, pos0++, { slot.id }, true);
+        }
+
+        // snapshot ckpt target PRIMA del decode, per memoria FULL E RS - pattern
+        // esatto dello shadow (bit-exact su RS, v. WHY laggiù).
+        const bool use_ckpt_tgt =
+            ctx_tgt_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_FULL ||
+            ctx_tgt_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_RS;
+        if (use_ckpt_tgt) {
+            slot.spec_ckpt.update_tgt(ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY | LLAMA_STATE_SEQ_FLAGS_ON_DEVICE);
+        }
+
+        // snapshot difensivo dello stato impl (boundary MTP), pattern dello
+        // shadow: il gate g_spec_shadow_processing nega l'ingest MTP delle righe
+        // noise, il restore protegge se il gate fosse rimosso.
+        std::vector<uint8_t> noise_spec_state;
+        const bool need_spec_state = common_speculative_state_required(spec.get());
+        if (need_spec_state && !common_speculative_get_state(spec.get(), slot.id, noise_spec_state)) {
+            // il restore finale salta il blob vuoto - non silenzioso, scremabile
+            SLT_WRN(slot, "%s", "spec-t9ci noise: impl-state snapshot failed - restore skipped, next real MTP draft may resync\n");
+        }
+
+        if (llama_decode(slot.ctx_tgt, slot.shadow_batch) == 0) {
+            // stessa scope-guard RAII dello shadow: l'head MTP NON ingerisce le
+            // righe noise (early-exit in process MTP), il mirror DF sì
+            struct shadow_processing_guard {
+                ~shadow_processing_guard() { common_speculative_set_shadow_processing(false); }
+            } noise_guard;
+            common_speculative_set_shadow_processing(true);
+
+            common_speculative_process(spec.get(), slot.shadow_batch); // mirror DF delle righe noise
+        } else {
+            // nessun logit da rollbackare (mai campionato): la memoria sotto
+            // viene comunque ripulita - la riga N resta scremabile dai log
+            SLT_WRN(slot, "%s", "spec-t9ci noise: verify decode failed - memory still rolled back\n");
+        }
+        const int64_t t1 = ggml_time_us();
+
+        // ---- rollback COMPLETO al boundary C_{r+1}, pattern dello shadow:
+        // ckpt (FULL/RS) + trim dei TRE contesti + restore stato impl.
+        if (use_ckpt_tgt) {
+            if (!slot.spec_ckpt.load_tgt(slot.ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY | LLAMA_STATE_SEQ_FLAGS_ON_DEVICE)) {
+                // best-effort: il decode è append-only, il trim sotto rimuove
+                // comunque tutte le righe noise; il round vero ri-snapshotta il
+                // ckpt alla prossima draft phase
+                SLT_WRN(slot, "%s", "spec-t9ci noise: speculative checkpoint restore failed (target) - trimming only\n");
+            }
+        }
+        // (1) target: righe noise oltre il boundary
+        common_context_seq_rm(slot.ctx_tgt, slot.id, pos_next, -1);
+        // (2) head MTP: difensivo/idempotente (il gate nega l'ingest - v. shadow)
+        common_context_seq_rm(slot.ctx_dft, slot.id, pos_next, -1);
+        // (3) ctx DF: il mirror ha ingerito le 8 righe noise a pos_next.. -
+        //     pos_bnd = pos_next-1 trima da pos_next, lo STESSO confine
+        //     effettivo del rollback_df dello shadow: laggiù pos_bnd è il
+        //     pos_max del ctx DF dopo il pre-trim da dp.n_past (= pos_next), cioè
+        //     pos_next-1 in condizioni normali (contratto speculative.h +
+        //     igiene pre-decode sopra che replica quel pre-trim). Qui non c'è
+        //     draft che lo catturi: il valore è derivato, non indovinato.
+        common_speculative_shadow_rollback_dflash(spec.get(), slot.id, pos_next - 1);
+        // stato impl (boundary MTP) riportato al boundary committato
+        if (need_spec_state && !noise_spec_state.empty()) {
+            common_speculative_set_state(spec.get(), slot.id, noise_spec_state);
+        }
+
+        spec_shadow_log("N,%d,%d,%d,%lld\n",
+                        slot.id, slot.task ? slot.task->id : -1, slot.n_spec_rounds,
+                        (long long)(t1 - t0));
+    }
+
+    // t9 charidentity (E2, SPEC_T9_DRAFT_ONLY): braccio di isolamento H2 - solo
+    // il draft DF shadow (stesso helper, stessi override dp dello shadow) con il
+    // suo rollback condizionale, NULL'ALTRO. Semantica dichiarata: E2 = ON meno
+    // {decode tgt, process, accept, trim target/head}. Lo stato interno dell'impl
+    // DF (smpls per-seq, selector_rng, contatori) avanza col round E2 - è
+    // ESATTAMENTE l'oggetto dell'ipotesi H2, non va ripristinato. Il ctx DF resta
+    // allineato dai round veri (mirror armato al boot, B2) come in ON.
+    void draft_only_round(server_slot & slot) {
+        // dp E2 = dp del round vero con override, identico allo shadow (copia
+        // by-value: il round vero la riscrive per intero alla prossima draft)
+        common_speculative_draft_params dp = common_speculative_get_draft_params(spec.get(), slot.id);
+        dp.drafting    = true;
+        dp.drafter     = COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH;
+        dp.n_max       = SHADOW_N_MAX_DF;
+        dp.pos_next    = slot.prompt.tokens.pos_next(); // = boundary C_{r+1}
+        dp.id_last     = slot.sampled;                  // bonus token del round r
+        dp.n_past      = slot.prompt.n_tokens();        // come il round vero (pos dell'ancora)
+        dp.result      = &slot.shadow_draft_buf;
+        dp.dists       = nullptr;    // accettazione greedy (no spec-dists)
+        dp.temperature = 0.0f;       // greedy: soddisfa l'assert dflash2 (temperature<=0 || dists)
+        dp.concat_head = nullptr;    // mai una testa concat in un round shadow
+        slot.shadow_draft_buf.clear();
+
+        const int64_t t0 = ggml_time_us();
+        llama_pos df_pos_bnd = 0;
+
+        const int n_df = common_speculative_shadow_draft_dflash(spec.get(), slot.id, dp, df_pos_bnd);
+        const int64_t t1 = ggml_time_us();
+
+        // SOLO se n_df > 0 (pattern condizionale esatto dello shadow): con
+        // df_pos_bnd=0 una chiamata incondizionata trimerebbe da pos 1 e
+        // cancellerebbe il prefisso specchiato (contaminazione catastrofica).
+        // L'helper ha GIÀ rimosso il noise block al ritorno: questo trim è il
+        // pairing difensivo del contratto (nessuna riga oltre pos_bnd attesa).
+        if (n_df > 0) {
+            common_speculative_shadow_rollback_dflash(spec.get(), slot.id, df_pos_bnd);
+        }
+
+        spec_shadow_log("D,%d,%d,%d,%d,%lld\n",
+                        slot.id, slot.task ? slot.task->id : -1, slot.n_spec_rounds,
+                        n_df, (long long)(t1 - t0));
+    }
+
     int get_slot_n_ctx() {
         return slots.back().n_ctx;
     }
-- 
