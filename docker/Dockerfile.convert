# Derived from docker-llm-service: adds the Python deps for convert_hf_to_gguf.py.
# The ROCmFPX fork converter (installed in the base container) requires the fork's
# custom gguf-py (it has MODEL_ARCH.DFLASH and other extensions not on PyPI).
# NOTE: main HEAD has DFLASH; commit 00d5452 does not (latent bug in the base container).
# NOTE: the base image `docker-llm-service:latest` is NOT publicly pullable — it is
# built locally from kyuz0/amd-strix-halo-toolboxes; build it first from
# https://github.com/kyuz0/amd-strix-halo-toolboxes
FROM docker-llm-service:latest

# Fedora 43 base — dnf for python3-pip + git.
RUN dnf -y --nodocs --setopt=install_weak_deps=False install python3-pip git \
  && dnf clean all && rm -rf /var/cache/dnf/*

# Custom gguf-py from the ROCmFPX fork's main HEAD (has MODEL_ARCH.DFLASH).
# Split into two RUNs: the first for gguf-py (cd / before rm to avoid cwd issues),
# the second for torch (with the replacement --index-url) and the other deps.
RUN git clone --depth=1 --branch main https://github.com/charlie12345/ROCmFPX.git /tmp/ROCmFPX \
  && pip install --no-cache-dir /tmp/ROCmFPX/gguf-py \
  && cd / && rm -rf /tmp/ROCmFPX

RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
  && pip install --no-cache-dir transformers==5.14.1 safetensors sentencepiece accelerate
